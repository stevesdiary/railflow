{
  "name": "railflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IRCTC-style railway booking platform - modular monolith",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "dev": "pnpm --filter @railflow/api dev",
    "db:generate": "pnpm --filter @railflow/api db:generate",
    "db:migrate": "pnpm --filter @railflow/api db:migrate",
    "db:deploy": "pnpm --filter @railflow/api db:deploy",
    "db:seed": "pnpm --filter @railflow/api db:seed",
    "db:studio": "pnpm --filter @railflow/api db:studio"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
