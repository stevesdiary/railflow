{
  "name": "@railflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@railflow/config": "workspace:*",
    "@railflow/contracts": "workspace:*",
    "@railflow/logger": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@railflow/testing": "workspace:^",
    "@types/node": "^26.1.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
