NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_REQUEST_TIMEOUT_MS=30000
CORS_ORIGIN=*

LOG_LEVEL=debug
LOG_REDACT_PATHS=password,passwordConfirm,accessToken,refreshToken,authorization,cookie,cardNumber,cvv,secret,apiKey

DATABASE_URL=postgresql://railflow:railflow@localhost:5432/railflow
REDIS_URL=redis://localhost:6379/0

# Minimum 32 chars each (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=change-me-refresh-secret-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

EMAIL_VERIFICATION_TOKEN_TTL=24h
PUBLIC_BASE_URL=http://localhost:3000
